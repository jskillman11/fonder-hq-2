# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real values.
# See HANDOFF.md > "Infra reference" for where these come from.

# Supabase project URL and anon (public) key — Project Settings > API
# in the Supabase dashboard (project ref: fklncuzxnrfdovigasgc).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — local-only, used by one-off/seed scripts
# (scripts/*.js). Never deployed to a client-reachable context. Marked
# Sensitive on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that guards the Shopify sync cron route
# (app/api/cron/sync-shopify). Any long random string; must match the
# value set on Vercel.
CRON_SECRET=
